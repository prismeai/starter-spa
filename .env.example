# Your Prisme.ai API URL — MUST include the /v2 suffix.
# Self-hosted example:  https://api.acme.example.com/v2
# Public sandbox:       https://api.sandbox.prisme.ai/v2
PRISMEAI_API_URL=

# Personal access token (recommended) — mint one in your platform UI under
# Settings → Access Tokens (/settings/tokens). Token format: at:<uuid>.
# User-scoped, revocable, has explicit expiry.
PRISMEAI_ACCESS_TOKEN=

# OR (legacy) — org-scoped API key created in the AI Governance app → API Keys.
# Use ONE of PRISMEAI_ACCESS_TOKEN or PRISMEAI_API_KEY. Access token is preferred.
# PRISMEAI_API_KEY=

# Workspace ID where the app will be deployed (the short ID, e.g. B4eoHS6).
PRISMEAI_WORKSPACE_ID=

# Optional: your Prisme.ai platform UI URL (e.g. https://app.acme.example.com),
# for `npm run sync-kit` (take your platform's app kit) and `npm run check`.
PRISMEAI_PLATFORM_URL=

# Optional: agent whose chat the app opens next to it (app.agent.open()).
# Unset keeps the agent already set (e.g. in the Builder); empty removes it.
# PRISMEAI_APP_AGENT=

# Optional: webhook of the MCP endpoint the views call (default: mcp).
# PRISMEAI_MCP_WEBHOOK=mcp

# Optional: app key. Defaults to the workspace slug returned by the API.
# Override only if you publish several apps to the same workspace.
# PRISMEAI_BUNDLE_SLUG=

# Optional: app version label written to workspace.config.value.bundles[slug].version
PRISMEAI_APP_VERSION=1.0.0

# For multi-env, copy this file to .env.<name> and pick at deploy time:
#   npm run deploy -- --env=staging
#   PRISMEAI_ENV=production npm run release

# Optional: public access (written to bundles[slug] at deploy). Your app is
# served at both /apps/<slug> and /p/<slug>; `public` decides whether login is
# required. Leave unset for the default (behind auth).
#   PRISMEAI_PUBLIC=true   # open without login: app.user is absent
# PRISMEAI_PUBLIC=true

# Optional: skip steps you don't need
# PRISMEAI_SKIP_AUTOMATIONS_SYNC=true  # don't push automations/*
# PRISMEAI_SKIP_SOURCE_SYNC=true       # don't push src/* into the workspace
# PRISMEAI_SKIP_BUNDLE_CLEANUP=true    # keep bundle files no app points at
# PRISMEAI_SKIP_VERSION_SNAPSHOT=true  # don't POST /workspaces/:id/versions

# Optional: replace an app deployed in the shared format (see README).
# PRISMEAI_ALLOW_FORMAT_SWITCH=true
