{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@prisme.ai/mcp-apps": ["./vendor/@prisme.ai/mcp-apps/index.d.ts"],
      "@prisme.ai/mcp-apps/react": ["./vendor/@prisme.ai/mcp-apps/react.d.ts"],
      "@prisme.ai/mcp-apps/boot": ["./vendor/@prisme.ai/mcp-apps/boot.d.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
