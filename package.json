{
  "name": "starter-spa",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Full-stack agentic app on Prisme.ai: React front end, declarative automations, MCP tools and an agent. Build locally, deploy to a workspace with one command.",
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_PRISME_LIVE=true vite",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "pull": "node scripts/pull.mjs",
    "undeploy": "node scripts/undeploy.mjs",
    "release": "npm run build && npm run deploy",
    "sync-kit": "node scripts/sync-kit.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "js-yaml": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
